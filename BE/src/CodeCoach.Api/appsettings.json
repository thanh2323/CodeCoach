{
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=codecoach;Username=postgres;Password=your-pass"
  },
  "Jwt": {
    "Issuer": "CodeCoach.Api",
    "Audience": "CodeCoach.Client",
    "SigningKey": "replace-with-a-long-random-development-key",
    "ExpirationMinutes": 60
  },
  "RefreshTokens": {
    "ExpirationDays": 7
  },

  "AuthCookies": {
    "AccessTokenCookieName": "your_access_token",
    "RefreshTokenCookieName": "your_refresh_token",
    "SameSite": "Lax",
    "HttpOnly": true,
    "Secure": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
